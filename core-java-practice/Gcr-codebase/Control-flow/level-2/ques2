import java.util.Scanner;

public class TriangleAreaCalculator {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter the base in cm: ");
        double baseInCentimeters = scanner.nextDouble();
        System.out.print("Enter the height in cm: ");
        double heightInCentimeters = scanner.nextDouble();
        double areaInSquareCentimeters = 0.5 * baseInCentimeters * heightInCentimeters;
        double areaInSquareInches = areaInSquareCentimeters / (2.54 * 2.54);
        System.out.println(
                "The Area of the triangle in sq in is "
                + areaInSquareInches
                + " and sq cm is "
                + areaInSquareCentimeters
        );

        scanner.close();
    }
}